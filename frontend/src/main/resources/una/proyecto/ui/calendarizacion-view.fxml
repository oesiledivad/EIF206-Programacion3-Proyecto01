<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="12.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="una.proyecto.controller.CalendarizacionController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <children>
        <VBox spacing="4.0">
            <children>
                <Label styleClass="title" text="Calendarización" />
                <Label styleClass="section-title" text="Seleccione una fecha y categoría para visualizar la disponibilidad de recursos" />
            </children>
        </VBox>

        <Separator />

        <VBox spacing="8.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Label minWidth="50.0" styleClass="subtitle" text="Fecha" />
                        <DatePicker fx:id="datepicker" prefHeight="32.0" prefWidth="160.0" />

                        <Label minWidth="70.0" styleClass="subtitle" text="Categoría" />
                        <ChoiceBox fx:id="choiceboxcategoria" prefHeight="32.0" prefWidth="180.0" />

                        <Button fx:id="btncargar" prefHeight="32.0" styleClass="btn-toggle-shadow-primary" text="Cargar">
                            <graphic>
                                <FontIcon iconLiteral="fa-search" styleClass="icon-primary" />
                            </graphic>
                        </Button>

                        <Button fx:id="btnImprimir" mnemonicParsing="false" onAction="#btnImprimir" prefHeight="32.0" styleClass="btn-toggle-shadow-warning" text="Imprimir">
                            <graphic>
                                <FontIcon iconColor="#910202" iconLiteral="fa-print" />
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

        <Separator />

        <VBox spacing="5.0" VBox.vgrow="ALWAYS">
            <children>
                <Label styleClass="section-title" text="Matriz de Disponibilidad" />
                <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colHoras" prefWidth="100.0" text="Horas" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>