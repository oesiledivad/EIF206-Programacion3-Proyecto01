<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="15.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="una.proyecto.controller.ChangePasswordController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <children>
        <Label styleClass="dialog-title" text="Cambiar Contraseña">
            <graphic>
                <FontIcon iconLiteral="fa-key" styleClass="icon-primary" />
            </graphic>
        </Label>

        <Label styleClass="dialog-subtitle" text="Ingrese sus credenciales para cambiar la contraseña" />

        <VBox spacing="4.0" styleClass="card-input-container">
            <children>
                <Label styleClass="input-label" text="Identifiación" />
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <FontIcon iconLiteral="fa-user" iconSize="16" styleClass="icon-primary" />
                        <TextField fx:id="txtUsuario" editable="false" promptText="Identifiación" style="-fx-opacity: 0.7;" styleClass="text-field-usuario" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <VBox spacing="4.0" styleClass="card-input-container">
            <children>
                <Label styleClass="input-label" text="Contraseña actual" />
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <FontIcon iconLiteral="fa-lock" iconSize="16" styleClass="icon-primary" />
                        <PasswordField fx:id="txtContrasenaActual" promptText="Ingrese su contraseña actual" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <VBox spacing="4.0" styleClass="card-input-container">
            <children>
                <Label styleClass="input-label" text="Nueva contraseña" />
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <FontIcon iconLiteral="fa-unlock" iconSize="16" styleClass="icon-primary" />
                        <PasswordField fx:id="txtNuevaContrasena" promptText="Nueva contraseña (mínimo 6 caracteres)" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <VBox spacing="4.0" styleClass="card-input-container">
            <children>
                <Label styleClass="input-label" text="Confirmar nueva contraseña" />
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <FontIcon iconLiteral="fa-check-circle" iconSize="16" styleClass="icon-primary" />
                        <PasswordField fx:id="txtConfirmarContrasena" promptText="Confirme su nueva contraseña" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <Label fx:id="lblError" styleClass="text-danger" text="" visible="false" wrapText="true" />

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="btnCancelar" prefHeight="32.0" styleClass="btn-toggle-shadow-success" text="Cancelar" />
                <Button fx:id="btnCambiar" prefHeight="32.0" styleClass="btn-toggle-shadow-primary" text="Cambiar Contraseña">
                    <graphic>
                        <FontIcon iconLiteral="fa-save" styleClass="icon-primary" />
                    </graphic>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>
