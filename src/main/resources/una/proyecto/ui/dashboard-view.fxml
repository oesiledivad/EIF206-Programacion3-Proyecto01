<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="550.0" prefWidth="650.0" spacing="20.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="una.proyecto.controller.DashboardController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <VBox spacing="4.0">
         <children>
            <Label styleClass="title" text="Dashboard">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Label fx:id="lblWelcome" styleClass="section-title" text="Bienvenido de vuelta">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <Label fx:id="lblUserWelcome" styleClass="section-title" text="Dashboard">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <VBox alignment="CENTER_LEFT" spacing="5.0" styleClass="card" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
               </padding>
               <children>
                  <Label text="Total Reservas" />
                  <Label fx:id="lblTotalReservas" styleClass="metric-value" text="0">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <VBox alignment="CENTER_LEFT" spacing="5.0" styleClass="card" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
               </padding>
               <children>
                  <Label text="Recursos Disponibles" />
                  <Label fx:id="lblRecursosDisponibles" styleClass="metric-value" text="0">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <VBox alignment="CENTER_LEFT" spacing="5.0" styleClass="card" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
               </padding>
               <children>
                  <Label text="Actividades hoy" />
                  <Label fx:id="lblActividadesHoy" styleClass="metric-value" text="0">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <VBox alignment="CENTER_LEFT" spacing="5.0" styleClass="card" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
               </padding>
               <children>
                  <Label text="Usuarios Activos" />
                  <Label fx:id="lblUsuariosActivos" styleClass="metric-value" text="0">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </HBox>
      <VBox spacing="10.0" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label styleClass="section-title" text="Reservas Recientes">
                     <font>
                        <Font size="15.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <TableView fx:id="tblReservasRecientes" editable="true" nodeOrientation="LEFT_TO_RIGHT" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colActividad" prefWidth="150.0" text="Actividad" />
                  <TableColumn fx:id="colFecha" prefWidth="100.0" text="Fecha" />
                  <TableColumn fx:id="colHora" prefWidth="100.0" text="Hora" />
                  <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
